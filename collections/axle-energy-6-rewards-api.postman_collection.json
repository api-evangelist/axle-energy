        {
          "id": "798d5392-5c65-4ae5-8cf7-e8c1d7f0d159",
          "name": "Get Rewards Balance Withdrawal Url",
          "request": {
            "name": "Get Rewards Balance Withdrawal Url",
            "description": {
              "content": "Get a temporary link to an Axle-hosted form through which users can view and withdraw rewards. Requires an organisational bearer token.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rewards",
                ":site_id",
                "url",
                "balance"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "enforce_two_factor_auth",
                  "value": "<boolean>",
                  "description": "Require email verification before the user can link a bank account. Balance and transaction-history views are not gated. When omitted, falls back to the organisation's configured 2FA posture."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<string>",
                  "description": "(Required) Where to redirect after completion"
                },
                {
                  "disabled": false,
                  "key": "hide_transactions",
                  "value": "false",
                  "description": "Hide transaction history from the user"
                },
                {
                  "disabled": false,
                  "key": "auto_redirect_to_setup",
                  "value": "false",
                  "description": "Skip the balance page and go straight to bank setup if no account exists"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "site_id",
                  "description": "(Required) The ID on Axle's system for this user. The site_id can be easily retrieved from the get-by-external-id endpoint."
