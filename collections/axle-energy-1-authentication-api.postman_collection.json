        {
          "id": "ca7d3a7b-ede3-4532-935e-71819917d8d1",
          "name": "Create Component Token",
          "request": {
            "name": "Create Component Token",
            "description": {
              "content": "Authenticate on behalf of an end user by supplying their external user ID.\n\nThis endpoint is used by authenticated API clients to create a user-scoped access token for a specific end user (referenced by their external ID) in the API client's organisation. If no such end user exists, one will be created on demand.\n\nReturns a bearer access token scoped to this end user upon success.\n\nThis token is site-scoped and valid for 24 hours, longer-lived than the standard organisation token (1 hour) as it is intended for end-user sessions.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "component-token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "accessTokenUrl",
                  "value": "auth/token-form"
                },
                {
                  "key": "grant_type",
                  "value": "password_credentials"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "external_user_id",
                  "value": "<string>",
                  "description": "(Required) Your ID for this end user; a site is created on demand if unknown"
                },
                {
                  "disabled": false,
                  "key": "allowed_origin",
                  "value": "<string>",
                  "description": "(Required) Origin allowed to embed the Axle-hosted flow"
                },
                {
                  "disabled": false,
                  "key": "user_email",
                  "value": "<string>",
                  "description": "The email of the user, to be added for new users or upserted for existing users."
                },
                {
                  "disabled": false,
                  "key": "gave_boundary_meter_consent_at",
                  "value": "<dateTime>",
                  "description": "Timezone-aware ISO 8601 timestamp (e.g. '2026-01-01T12:34:56Z') indicating when the household gave consent for Axle to access readings from their boundary meter, if consent was given.\n\nUnless explicitly exempted, this must be provided on the first call for a new `external_user_id`. It can optionally be included in later calls for the same `external_user_id`; the value submitted most recently will be kept on record."
                }
              ]
            }
          },
          "response": [
